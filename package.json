{
  "name": "phishguard-desktop",
  "productName": "PhishGuard",
  "version": "1.0.0",
  "description": "PhishGuard link protection for Windows",
  "main": "src/main.js",
  "author": "PhishGuard",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.phishguard.desktop",
    "productName": "PhishGuard",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "deleteAppDataOnUninstall": false }
  }
}
